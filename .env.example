# PostgreSQL connection string
# Local Postgres example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vegpro_passport
#
# Supabase on Windows/IPv4-only networks: use the Session pooler URL from
# Dashboard → Connect (often aws-1-<region>.pooler.supabase.com:5432, user postgres.<project-ref>).
# Direct db.<project-ref>.supabase.co is often IPv6-only and may fail with ENOTFOUND in Node.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret

# Required for Auth.js when using `next start` / production mode locally
AUTH_URL=http://localhost:5001

# Optional: force Playwright to start a fresh server (see docs/RELEASE_CHECKLIST.md)
# CI=true

# Public base URL — must match how clients reach the app (see README: QR phone testing)
# Local dev on this machine only:
NEXT_PUBLIC_APP_URL=http://localhost:5001
# Phone/LAN scan testing (same Wi‑Fi, replace with your machine's LAN IP):
# NEXT_PUBLIC_APP_URL=http://192.168.1.100:5001
